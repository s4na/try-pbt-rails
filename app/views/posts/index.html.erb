<h1>ブログ記事一覧</h1>

<% if logged_in? %>
  <p><%= link_to "新規投稿", new_post_path %></p>
<% end %>

<% @posts.each do |post| %>
  <article>
    <h2><%= link_to post.title, post %></h2>
    <p>投稿者: <%= post.user.name %> | <%= post.created_at.strftime("%Y/%m/%d %H:%M") %></p>
    <p><%= truncate(post.body, length: 100) %></p>
  </article>
  <hr>
<% end %>

<% if @posts.empty? %>
  <p>まだ記事がありません。</p>
<% end %>
